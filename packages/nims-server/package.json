{
  "name": "nims-server",
  "version": "0.8.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "nims-nodemon": "nodemon ./bin/www --configFile \"config/nims-frontend-local.json\"  --globalConfigFile \"config/nims-frontend-global.json\"",
    "watch:server": "nodemon ./bin/www --configFile \"config/nims-frontend-local.json\"  --globalConfigFile \"config/nims-frontend-global.json\"",
    "nims-node": "node ./bin/www --configFile \"config/nims-frontend-local.json\"  --globalConfigFile \"config/nims-frontend-global.json\"",
    "test": "node --test tests/",
    "test:integration": "node mcp/test/api-rbac-test.mjs && node mcp/test/mcp-permissions-test.mjs",
    "test:all": "npm test && npm run test:integration",
    "test:cov": "c8 --include=pg/** --include=permissions/permissionProxy.js --include=middlewares/requestProcessing.js --include=routes/auth.js --reporter=text --reporter=html --check-coverage --lines=60 --branches=45 node --test tests/"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "body-parser": "^1.19.0",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "cross-env": "^7.0.2",
    "errorhandler": "^1.5.1",
    "express": "^4.17.1",
    "express-session": "^1.17.1",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "nconf": "^0.10.0",
    "passport": "^0.4.1",
    "passport-local": "^1.0.0",
    "ramda": "^0.27.0",
    "serve-favicon": "^2.5.0",
    "winston": "^3.2.1",
    "dateformat": "^3.0.3",
    "zod": "^3.23.0",
    "nims-resources": "0.8.0",
    "nims-dbms": "0.8.0",
    "nims-dbms-core": "0.8.0",
    "pg": "^8.13.0"
  },
  "private": true
}
