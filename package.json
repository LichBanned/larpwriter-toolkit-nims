{
  "name": "root",
  "private": true,
  "devDependencies": {
    "lerna": "^3.22.1",
    "c8": "^10.1.3"
  },
  "scripts": {
    "bootstrap": "lerna bootstrap",
    "clean-bootstrap": "lerna clean && lerna bootstrap",
    "lerna:clean": "lerna clean",
    "build:app": "cd packages/nims-app && npm run build",
    "build:dbms": "cd packages/nims-dbms && npx tsc",
    "dev": "cd packages/nims-server && node ./bin/www --configFile config/nims-frontend-local.json --globalConfigFile config/nims-frontend-global.json",
    "test": "cd packages/nims-server && npm test",
    "test:all": "cd packages/nims-server && npm run test:all",
    "test:docker": "docker compose -f docker-compose.test.yml build && docker compose -f docker-compose.test.yml run --rm -e COVERAGE=0 test",
    "test:docker:cov": "docker compose -f docker-compose.test.yml build && docker compose -f docker-compose.test.yml run --rm -e COVERAGE=1 test",
    "test:docker:down": "docker compose -f docker-compose.test.yml down -v --remove-orphans"
  },
  "dependencies": {}
}
